# ── MongoDB ───────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/structura
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/structura
MONGODB_URI=mongodb://127.0.0.1:27017/structura

# ── Sessions ──────────────────────────────────────────────────────────────
# Any long random string. Sessions are stored in MongoDB (connect-mongo),
# so they survive server restarts and work across multiple instances.
SESSION_SECRET=change-this-to-a-long-random-string

# ── AI providers (set AT LEAST ONE; the more you set, the more reliable) ──
# The app tries them in order and automatically fails over when one hits its
# quota / rate limit. Each accepts several keys separated by commas
# (every key has its own quota), e.g.  GROQ_API_KEY=gsk_a,gsk_b
GROQ_API_KEY=gsk_your_key_here            # https://console.groq.com/keys
GEMINI_API_KEY=                           # https://aistudio.google.com/apikey
CEREBRAS_API_KEY=                         # https://cloud.cerebras.ai
OPENROUTER_API_KEY=                       # https://openrouter.ai/keys

# Optional: change the order or the models without editing code
# LLM_PROVIDER_ORDER=groq,gemini,cerebras,openrouter
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# ── Diagram rendering (optional) ──────────────────────────────────────────
# Your own PlantUML server (see README: docker run -p 8080:8080 plantuml/plantuml-server:jetty)
# PLANTUML_SERVER=https://your-plantuml-host/plantuml

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
